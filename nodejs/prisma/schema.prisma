generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  role         Role     @default(USER)
  status       String   @default("active")
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  groupId String?
  group   CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  address         Address?
  orders          Order[]
  wishlist        WishlistItem[]
  reviews         Review[]
  tickets         Ticket[]        @relation("CustomerTickets")
  assignedTickets Ticket[]        @relation("AssignedTickets")
  ticketMessages  TicketMessage[]

  @@index([groupId])
  @@map("users")
}

model Address {
  id        String   @id @default(uuid())
  userId    String   @unique
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model OtpVerification {
  id         String    @id @default(uuid())
  phone      String
  otpHash    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@map("otp_verifications")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?
  sortOrder   Int        @default(0)
  status      String     @default("active")
  parentId    String?
  parent      Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryParent")
  products    Product[]
  homeFeature HomeCategoryFeature?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Collection {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("active")
  featured    Boolean   @default(false)
  products    Product[]
  homeFeature HomeCollectionFeature?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("collections")
}

model Product {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  sku              String   @unique
  description      String?
  shortDescription String?

  price           Decimal @db.Decimal(10, 2)
  salePrice       Decimal? @db.Decimal(10, 2)
  costPrice       Decimal? @db.Decimal(10, 2)
  taxPercent      Decimal  @default(0) @db.Decimal(5, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)

  stock             Int     @default(0)
  lowStockThreshold Int     @default(5)
  availability      String  @default("in-stock")
  allowBackorder    Boolean @default(false)

  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collections Collection[]

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  tags String[] @default([])

  mainImage String?
  thumbnail String?
  gallery   String[] @default([])

  metaTitle       String?
  metaDescription String?
  keywords        String?

  status     String  @default("draft")
  featured   Boolean @default(false)
  bestSeller Boolean @default(false)

  unitsSold   Int     @default(0)
  revenue     Decimal @default(0) @db.Decimal(12, 2)
  rating      Decimal @default(0) @db.Decimal(3, 2)
  reviewCount Int     @default(0)

  variants     ProductVariant[]
  movements    InventoryMovement[]
  orderItems   OrderItem[]
  wishlistedBy WishlistItem[]
  homeFeature  BestSellerFeature?
  reviews      Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  logo      String?
  status    String    @default("active")
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("brands")
}

model ProductAttribute {
  id        String   @id @default(uuid())
  name      String   @unique
  values    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_attributes")
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@map("reviews")
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String?
  color     String?
  material  String?
  sku       String
  price     Decimal @db.Decimal(10, 2)
  stock     Int     @default(0)

  @@index([productId])
  @@map("product_variants")
}

model InventoryMovement {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String
  quantity  Int
  note      String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("inventory_movements")
}

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  customerName String
  email        String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String @default("India")

  items OrderItem[]

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  shipping Decimal @default(0) @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  paymentMethod String  @default("cod")
  paymentStatus String  @default("pending")
  status        String  @default("pending")
  couponCode    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName String
  image       String?
  variant     String?
  quantity    Int
  price       Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@map("order_items")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model HeroBanner {
  id                  String   @id @default(uuid())
  desktopImage        String?
  mobileImage         String?
  heading             String
  subheading          String?
  description         String?
  primaryButtonText   String?
  primaryButtonLink   String?
  secondaryButtonText String?
  secondaryButtonLink String?
  startDate           DateTime?
  endDate             DateTime?
  status              String   @default("active")
  displayOrder        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("hero_banners")
}

model HomeCategoryFeature {
  id            String   @id @default(uuid())
  categoryId    String   @unique
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  displayOrder  Int      @default(0)
  status        String   @default("active")
  createdAt     DateTime @default(now())

  @@map("home_category_features")
}

model HomeCollectionFeature {
  id               String     @id @default(uuid())
  collectionId     String     @unique
  collection       Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  shortDescription String?
  link             String?
  displayOrder     Int        @default(0)
  status           String     @default("active")
  createdAt        DateTime   @default(now())

  @@map("home_collection_features")
}

model BestSellerFeature {
  id           String   @id @default(uuid())
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  displayOrder Int      @default(0)
  status       String   @default("active")
  createdAt    DateTime @default(now())

  @@map("best_seller_features")
}

model CommunityImage {
  id           String   @id @default(uuid())
  image        String
  title        String?
  description  String?
  socialUrl    String?
  displayOrder Int      @default(0)
  status       String   @default("active")
  createdAt    DateTime @default(now())

  @@map("community_images")
}

model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique
  discountType  String
  discountValue Decimal  @db.Decimal(10, 2)
  minOrder      Decimal  @default(0) @db.Decimal(10, 2)
  maxDiscount   Decimal? @db.Decimal(10, 2)
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int      @default(0)
  usedCount     Int      @default(0)
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("coupons")
}

model Discount {
  id         String    @id @default(uuid())
  name       String
  type       String
  value      Decimal   @db.Decimal(10, 2)
  appliesTo  String    @default("all")
  targetId   String?
  targetName String?
  startDate  DateTime
  endDate    DateTime
  status     String    @default("active")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("discounts")
}

model MarketingBanner {
  id        String    @id @default(uuid())
  title     String
  image     String?
  link      String?
  position  String    @default("top")
  startDate DateTime?
  endDate   DateTime?
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("marketing_banners")
}

model Testimonial {
  id            String   @id @default(uuid())
  customerName  String
  customerImage String?
  rating        Int
  review        String
  date          DateTime @default(now())
  status        String   @default("pending")
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("testimonials")
}

model HomePromotion {
  id          String    @id @default(uuid())
  title       String
  description String?
  bannerImage String?
  buttonText  String?
  buttonUrl   String?
  discount    String?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("home_promotions")
}

model NewsletterConfig {
  id              String   @id @default("singleton")
  title           String   @default("")
  description     String?
  backgroundImage String?
  buttonText      String   @default("Subscribe")
  placeholderText String   @default("Enter your email address")
  status          String   @default("active")
  updatedAt       DateTime @updatedAt

  @@map("newsletter_config")
}

model Faq {
  id           String   @id @default(uuid())
  question     String
  answer       String
  category     String?
  displayOrder Int      @default(0)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("faqs")
}

model StaticPage {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  content   String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("static_pages")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model Ticket {
  id      String @id @default(uuid())
  ticketNumber String @unique

  customerId String
  customer   User   @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Cascade)

  subject  String
  category String?
  priority String  @default("medium")
  status   String  @default("open")

  assignedAdminId String?
  assignedAdmin   User?   @relation("AssignedTickets", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  messages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("tickets")
}

model TicketMessage {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  message   String
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_messages")
}

model CustomerGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  members     User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("customer_groups")
}

model StoreSettings {
  id      String @id @default("singleton")

  storeName    String  @default("")
  logo         String?
  favicon      String?
  contactEmail String?
  contactPhone String?
  address      String?

  shippingMethods       Json    @default("[]")
  freeShippingThreshold Decimal @default(0) @db.Decimal(10, 2)

  paymentMethods String[] @default(["cod"])
  currency       String   @default("INR")

  taxName          String  @default("GST")
  taxRate          Decimal @default(0) @db.Decimal(5, 2)
  pricesIncludeTax Boolean @default(false)

  emailNotifications    Boolean @default(true)
  orderNotifications    Boolean @default(true)
  customerNotifications Boolean @default(true)

  instagram String?
  facebook  String?
  youtube   String?
  twitter   String?

  updatedAt DateTime @updatedAt

  @@map("store_settings")
}
