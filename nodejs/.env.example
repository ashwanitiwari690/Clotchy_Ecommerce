NODE_ENV=development
PORT=5000

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/CLOTCHCY_DB?schema=public"

# Comma-separated list of allowed Angular dev server origins (credentials: true
# requires explicit origins, not *) - storefront (4200) and admin panel (4300).
CORS_ORIGIN=http://localhost:4200,http://localhost:4300

# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# No refresh token: this access token is the persistent session itself (httpOnly
# cookie), valid until it expires or the user logs out.
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRY=30d
ACCESS_TOKEN_EXPIRY_MS=2592000000

# Fast2SMS OTP template API (https://www.fast2sms.com/dev/otp/send).
# API key: Fast2SMS dashboard > Dev API. otp_id is your approved OTP template ID.
FAST2SMS_API_KEY=
FAST2SMS_OTP_TEMPLATE_ID=

OTP_LENGTH=4
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_VERIFICATION_VALIDITY_MINUTES=15
